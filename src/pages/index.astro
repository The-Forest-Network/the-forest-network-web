---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="The Forest Network" logoSize="large">
  <div class="intro">
    <p class="blurb">
      Allow yourself to be drawn down, down, down...through the mycelium and into
      The Forest Network. A place to find solace, to dream the dream of the earth, and to deepen into Mystery with other beings.
    </p>
    <p class="blurb">Curious? <a href="/about">Learn more about us</a>.</p>
    <a class="join" href="/village/join">Join the Village</a>
  </div>
</SiteLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .blurb {
    max-width: 44rem;
    font-size: clamp(1.6rem, 3.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.45;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
  }

  .join {
    margin-top: 2.5rem;
    padding: 0.7rem 1.8rem;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    color: #0b1208;
    background: #d4e8ac;
    border-radius: 999px;
    text-decoration: none;
  }

  .join:hover {
    color: #0b1208;
    background: #fff;
  }
</style>
