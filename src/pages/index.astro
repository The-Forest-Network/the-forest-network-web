---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Coming Soon" logoSize="large">
  <div class="intro">
    <h1>Coming Soon</h1>
    <a class="mail" href="mailto:trailhead@theforestnetwork.earth">trailhead@theforestnetwork.earth</a>
    <a class="join" href="/village/join">Join the Village</a>
  </div>
</SiteLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
  }

  .mail {
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
  }

  .join {
    padding: 0.7rem 1.8rem;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    color: #0b1208;
    background: #d4e8ac;
    border-radius: 999px;
    text-decoration: none;
  }

  .join:hover {
    color: #0b1208;
    background: #fff;
  }
</style>
