---
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  effectiveDate?: string;
  lastUpdated?: string;
}

const { title, effectiveDate, lastUpdated = effectiveDate } = Astro.props;
---

<SiteLayout title={title}>
  <article class="site-panel">
    <h1>{title}</h1>
    {effectiveDate ? (
      <p class="dates">Effective date: {effectiveDate}&nbsp;&nbsp;&nbsp;Last updated: {lastUpdated}</p>
    ) : lastUpdated && (
      <p class="dates">Last updated: {lastUpdated}</p>
    )}
    <div class="doc">
      <slot />
    </div>
  </article>
</SiteLayout>

<style>
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .dates {
    font-size: 0.95rem;
    color: #b9cc99;
    margin-bottom: 2.5rem;
  }

  .doc :global(h2) {
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }

  .doc :global(h2:first-child) {
    margin-top: 0;
  }

  .doc :global(p),
  .doc :global(li) {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .doc :global(p) {
    margin-bottom: 1.1rem;
  }

  .doc :global(ul) {
    margin: 0 0 1.1rem 1.4rem;
  }

  .doc :global(li) {
    margin-bottom: 0.5rem;
    padding-left: 0.3rem;
  }

  .doc :global(li)::marker {
    color: #8fb06a;
  }

  .doc :global(strong) {
    font-weight: 600;
  }
</style>
