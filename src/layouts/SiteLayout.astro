---
// Shared site layout: forest backdrop, Figtree, the app logo as the masthead, and
// content set on a translucent panel so text stays legible over the photograph.
import figtreeRegularUrl from '@fontsource/figtree/files/figtree-latin-400-normal.woff2?url';
import figtreeSemiUrl from '@fontsource/figtree/files/figtree-latin-600-normal.woff2?url';

interface Props {
  title: string;
  logoSize?: 'large' | 'small';
}

const { title, logoSize = 'small' } = Astro.props;

const fontFaceCSS = `
@font-face {
  font-family: 'Figtree';
  font-style: normal;
  font-weight: 400;
  font-display: block;
  src: url(${figtreeRegularUrl}) format('woff2');
}
@font-face {
  font-family: 'Figtree';
  font-style: normal;
  font-weight: 600;
  font-display: block;
  src: url(${figtreeSemiUrl}) format('woff2');
}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · The Forest Network</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={figtreeRegularUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeSemiUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaceCSS}></style>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgba(4, 9, 3, 0.7) 0%, rgba(4, 9, 3, 0.55) 50%, rgba(4, 9, 3, 0.8) 100%),
          url('/forest.jpg') center center / cover no-repeat fixed;
        background-color: #0b1208;
        font-family: 'Figtree', ui-rounded, system-ui, sans-serif;
        font-weight: 400;
        line-height: 1.6;
        color: #f0f7e6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: #d4e8ac;
        text-decoration: underline;
        text-decoration-color: rgba(212, 232, 172, 0.5);
        text-underline-offset: 0.25em;
      }

      a:hover {
        color: #fff;
        text-decoration-color: currentColor;
      }

      a:focus-visible {
        outline: 2px solid #d4e8ac;
        outline-offset: 4px;
        border-radius: 2px;
      }

      .site-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 3rem 1.25rem 2rem;
      }

      .site-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        color: #f0f7e6;
        margin-bottom: 2.5rem;
      }

      .site-brand img {
        border-radius: 22%;
        box-shadow: 0 6px 32px rgba(0, 0, 0, 0.6);
        width: 4.5rem;
        height: auto;
      }

      .site-brand--large img {
        width: clamp(8rem, 22vw, 11rem);
      }

      .site-brand span {
        font-size: 1.15rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .site-panel {
        width: 100%;
        max-width: 48rem;
        padding: clamp(1.5rem, 5vw, 3rem);
        background: rgba(8, 16, 6, 0.72);
        border: 1px solid rgba(212, 232, 172, 0.18);
        border-radius: 1rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5);
      }

      .site-footer {
        margin-top: auto;
        padding-top: 2.5rem;
        font-size: 1rem;
        text-align: center;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
      }

      .site-opensource {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
        padding: 0.45rem 1rem;
        font-size: 0.95rem;
        color: #f0f7e6;
        text-decoration: none;
        background: rgba(8, 16, 6, 0.6);
        border: 1px solid rgba(212, 232, 172, 0.35);
        border-radius: 999px;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }

      .site-opensource:hover {
        color: #fff;
        border-color: #d4e8ac;
      }

      .site-opensource svg {
        width: 1.15rem;
        height: 1.15rem;
        fill: currentColor;
      }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <a href="/" class={`site-brand ${logoSize === 'large' ? 'site-brand--large' : ''}`}>
        <img src="/mobile-icon.png" alt="" width="512" height="511" />
        <span>The Forest Network</span>
      </a>
      <slot />
      <footer class="site-footer">
        <a
          class="site-opensource"
          href="https://github.com/The-Forest-Network"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
          </svg>
          We&rsquo;re open source
        </a>
        <br />
        <a href="/village/privacy">Privacy</a> &nbsp;·&nbsp; <a href="/village/terms">Terms</a> &nbsp;·&nbsp; <a href="/village/copyright">Copyright</a> &nbsp;·&nbsp; <a href="/village/support">Support</a>
      </footer>
    </div>
  </body>
</html>
