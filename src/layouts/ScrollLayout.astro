---
// Layout for full-bleed, multi-section scrolling pages (e.g. /village/join).
// Unlike BaseLayout, this doesn't center a single viewport-height block with
// overflow:hidden — pages using this layout manage their own <section>s and
// scrolling.
import figtreeLightUrl from '@fontsource/figtree/files/figtree-latin-300-normal.woff2?url';
import figtreeRegularUrl from '@fontsource/figtree/files/figtree-latin-400-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;

const fontFaceCSS = `
@font-face {
  font-family: 'Figtree';
  font-style: normal;
  font-weight: 300;
  font-display: block;
  src: url(${figtreeLightUrl}) format('woff2');
}
@font-face {
  font-family: 'Figtree';
  font-style: normal;
  font-weight: 400;
  font-display: block;
  src: url(${figtreeRegularUrl}) format('woff2');
}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · The Forest Network</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href={figtreeLightUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeRegularUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaceCSS}></style>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        background: #0b1208;
        font-family: 'Figtree', ui-rounded, system-ui, sans-serif;
        color: #c8d8b0;
      }

      a {
        color: #a8c480;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
